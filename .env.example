# Copy this file to .env.local and adjust as needed.

# "mock" (default) uses the in-memory demonstration dataset in src/data/.
# "http" switches every page in the app to the real FastAPI backend via
# httpDataProvider — no component code needs to change.
VITE_DATA_PROVIDER=mock

# Base URL for the FastAPI backend. Only used when VITE_DATA_PROVIDER=http.
VITE_API_BASE_URL=http://localhost:8000/api

# Artificial latency (ms) the mock provider waits before resolving, so
# loading states are visible during development. Has no effect in http mode.
VITE_MOCK_LATENCY_MS=280
